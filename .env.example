# ==============================================================================
# NETRAWEBAI ENVIRONMENT CONFIGURATION
# Copy this file to .env.local (or .env) for development & testing.
# NEVER commit production secret keys into version control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Contact Number (for direct wa.me chat and click-to-chat links)
# Format: Country code followed by 10-digit number without '+' or '-'
NEXT_PUBLIC_WHATSAPP_NUMBER=919829012345

# Database Configuration
# Defaults to file-backed resilient storage in .data/db.json with mutex concurrency
DATABASE_URL=file:.data/db.json

# Resend Email Integration (https://resend.com)
# When left unconfigured, system runs in resilient email simulation mode
RESEND_API_KEY=re_test_placeholder_key_here
CONTACT_EMAIL=owner@netrawebai.com
RESEND_FROM_EMAIL=Netrawebai Notifications <onboarding@resend.dev>

# Razorpay Payment Gateway (https://razorpay.com)
# Test Mode Key ID and Secret Key
RAZORPAY_KEY_ID=rzp_test_netrawebai123
RAZORPAY_KEY_SECRET=rzp_test_secret_netrawebai456
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_789

# Administrative Dashboard Access
# Used to authenticate owner portal (/admin) for preparing quotes and viewing enquiries
ADMIN_PASSWORD=admin_netrawebai_2026
